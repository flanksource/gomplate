{
  "extends": [
    "schedule:weekends"
  ],
  "separatePatchReleases": false,
  "prCreation": "immediate",
  "branchPrefix": "renovate/",
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "automerge": true
  },
  "docker": {
    "fileMatch": [
      "(^|/)Dockerfile.*$"
    ],
    "major": {
      "enabled": true
    }
  },
  "ignorePaths": [
    "vendor/**"
  ],
  "rangeStrategy": "auto",
  "rebaseStalePrs": true,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 4,
  "labels": [
    "dependencies"
  ],
  "baseBranchPatterns": [
    "main",
    "3.x"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "vulnerabilityFixStrategy": "lowest",
    "addLabels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Maintain v3 with reviewed security fixes only",
      "matchBaseBranches": [
        "3.x"
      ],
      "matchPackageNames": [
        "*"
      ],
      "enabled": false,
      "automerge": false
    },
    {
      "description": "Preserve the CEL module path on v3",
      "matchBaseBranches": [
        "3.x"
      ],
      "matchPackageNames": [
        "github.com/google/cel-go"
      ],
      "allowedVersions": "<0.32.0"
    }
  ]
}
