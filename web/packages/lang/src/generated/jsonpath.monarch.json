{
  "defaultToken": "",
  "tokenPostfix": ".jsonpath",
  "brackets": [
    {
      "open": "[",
      "close": "]",
      "token": "delimiter.square"
    },
    {
      "open": "(",
      "close": ")",
      "token": "delimiter.parenthesis"
    }
  ],
  "filterOperators": [
    "!",
    "!=",
    "\u0026\u0026",
    "*",
    "+",
    "-",
    "/",
    "\u003c",
    "\u003c=",
    "==",
    "=~",
    "\u003e",
    "\u003e=",
    "||"
  ],
  "tokenizer": {
    "root": [
      [
        "\\$",
        "variable.root"
      ],
      [
        "@",
        "variable.current"
      ],
      [
        "\\.\\.",
        "operator.descendant"
      ],
      [
        "\\*",
        "operator.wildcard"
      ],
      [
        "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
        [
          "delimiter",
          "variable.field"
        ]
      ],
      [
        "\\.",
        "delimiter"
      ],
      [
        "\\?\\(",
        "keyword.filter"
      ],
      [
        "[\\[\\]()]",
        "@brackets"
      ],
      [
        "\"(?:[^\"\\\\]|\\\\.)*\"",
        "string"
      ],
      [
        "'(?:[^'\\\\]|\\\\.)*'",
        "string"
      ],
      [
        "\\b(?:true|false|null)\\b",
        "keyword.constant"
      ],
      [
        "-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?",
        "number"
      ],
      [
        "(?:==|!=|\u003c=|\u003e=|\u0026\u0026|\\|\\||=~|[\u003c\u003e!+\\-*/])",
        "operator"
      ],
      [
        ":",
        "operator.slice"
      ],
      [
        ",",
        "delimiter"
      ],
      [
        "[A-Za-z_][A-Za-z0-9_]*",
        "variable.field"
      ]
    ]
  }
}
